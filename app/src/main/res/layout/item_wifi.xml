<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtSsid" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="SSID" android:textSize="18sp" android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtRssi" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="RSSI: -50 dBm" android:textSize="15sp" android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/txtSsid"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtQuality" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="Sinal: Bom" android:textSize="14sp" android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/txtRssi"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
