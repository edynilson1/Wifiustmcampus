<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtTitle" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="WiFi Campus Scanner" android:textSize="28sp" android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtInfo" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="Pesquise redes Wi-Fi próximas e compare a intensidade do sinal."
        android:textSize="16sp" android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtTitle" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayout" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="36dp" android:hint="Nome ou parte do nome da rede"
        app:layout_constraintTop_toBottomOf="@id/txtInfo" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtNetwork" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnSearch" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="PESQUISAR WI-FI" android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/inputLayout" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtHint" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="Dica: ative o Wi-Fi e a localização do dispositivo para permitir a pesquisa."
        android:textSize="14sp" android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnSearch" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
